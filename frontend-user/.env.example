# meetCITAD User Frontend - Environment Variables

# API path used by the browser (proxied by Vite in development).
VITE_API_BASE_URL=/api/v1

# Origin used to resolve uploaded images/certificates returned by the API.
# Leave empty in production when the API and frontend share a domain.
VITE_API_ORIGIN=http://localhost:4000

# Development proxy target for /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000
